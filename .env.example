APP_PORT=3000
APP_PROBE_PORT=9090
NODE_ENV=development
APP_CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true
APP_SHUTDOWN_TIMEOUT_MS=15000
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://moazez:moazez@localhost:5433/moazez_dev
DATABASE_RUNTIME_ROLE=api
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
QUEUE_REDIS_URL=redis://localhost:6379
REALTIME_REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=moazez-dev
STORAGE_PUBLIC_BUCKET=moazez-dev-public
STORAGE_CORS_ORIGINS=http://localhost:3001
# For GCS set STORAGE_PROVIDER=gcs; ADC replaces MinIO endpoint/access credentials.
# GCP_PROJECT_ID=moazez-nonprod-project-id
# GCS_SIGNING_SERVICE_ACCOUNT=moazez-gcs-signer@moazez-nonprod-project-id.iam.gserviceaccount.com

FFPROBE_PATH=/usr/bin/ffprobe
FFPROBE_TIMEOUT_MS=15000
FFPROBE_MAX_OUTPUT_BYTES=1048576
MEDIA_VERIFICATION_VERSION=ffprobe-5.1.9-debian12-learning-media-v1
MEDIA_RUNTIME_ENFORCE_IN_TEST=false

# Fake deterministic local examples. Each configured key must decode to 32 bytes.
SETTINGS_EMAIL_SECRET_ENCRYPTION_ACTIVE_KEY_ID=local-email-v2
SETTINGS_EMAIL_SECRET_ENCRYPTION_ACTIVE_KEY=hex:1111111111111111111111111111111111111111111111111111111111111111
APP_DEVICE_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=local-device-token-v2
APP_DEVICE_TOKEN_ENCRYPTION_ACTIVE_KEY=hex:2222222222222222222222222222222222222222222222222222222222222222

# Optional active/previous overlap during a rotation. IDs are family-local metadata.
# SETTINGS_EMAIL_SECRET_ENCRYPTION_PREVIOUS_KEY_ID=previous-email-v2
# SETTINGS_EMAIL_SECRET_ENCRYPTION_PREVIOUS_KEY=hex:3333333333333333333333333333333333333333333333333333333333333333
# APP_DEVICE_TOKEN_ENCRYPTION_PREVIOUS_KEY_ID=previous-device-token-v2
# APP_DEVICE_TOKEN_ENCRYPTION_PREVIOUS_KEY=hex:4444444444444444444444444444444444444444444444444444444444444444

# Optional legacy v1 decrypt-only compatibility. Never used for new writes.
# SETTINGS_SECRET_ENCRYPTION_KEY=hex:5555555555555555555555555555555555555555555555555555555555555555

SEED_DEMO_DATA=true
LOG_LEVEL=debug
